diff --git a/report_archive.py b/report_archive.py
--- /dev/null
+++ b/report_archive.py
@@ -0,0 +1,392 @@
+"""Explicit archival of selected historical handoff entries, never read-time aging.
+
+The index and chunks are immutable JSON objects. The canonical document is the
+only mutable root. Existing writers receive fully reconstructed ordinary Python
+values; their updates may append to histories or change a formerly archived
+entry. Changed entries become inline again, retaining the old archived version.
+"""
+import copy
+import hashlib
+import json
+import os
+import re
+import stat
+import tempfile
+from datetime import datetime
+from pathlib import Path
+
+META = '_reportHistoryArchive'
+MARKER = '$reportHistoryArchive'
+FORMAT = 'report-handoff-history-v1'
+FIELDS = frozenset({
+    'p1cExecutionPlanHistory', 'p1cMasksLayersAssignmentHistory',
+    'p1bBrowserCheckpointHistory', 'p1bBrowserCorrectionCheckpointHistory',
+    'p1cMasksLayersImplementationCheckpointHistory', 'p1cMasksLayersCheckpoints',
+})
+NON_MATERIAL = frozenset({'review', 'maintenance', 'archive', 'health-check',
+                          'backup', 'page-view', 'read-receipt'})
+
+
+def check(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def encoded(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                      separators=(',', ':'), allow_nan=False).encode('utf-8')
+
+
+def digest(value):
+    result = hashlib.sha256()
+    for piece in json.JSONEncoder(ensure_ascii=False, sort_keys=True,
+                                  separators=(',', ':'), allow_nan=False).iterencode(value):
+        result.update(piece.encode('utf-8'))
+    return result.hexdigest()
+
+
+def descriptor(raw):
+    return {'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}
+
+
+def stamp(value):
+    check(isinstance(value, str) and 'T' in value, 'Exact activity timestamp required')
+    try:
+        parsed = datetime.fromisoformat(value.replace('Z', '+00:00'))
+    except ValueError as error:
+        raise ValueError('Invalid activity timestamp') from error
+    check(parsed.tzinfo is not None, 'Activity timestamp needs an explicit timezone')
+    return parsed
+
+
+def latest_activity(record):
+    check(isinstance(record, dict), 'Historical entries must be objects')
+    values = [record[key] for key in ('at', 'recordedAt', 'updatedAt') if key in record]
+    check(values, 'Undated history must remain inline')
+    # A malformed/date-only direct field is ambiguous even if another is valid.
+    return max(values, key=stamp)
+
+
+def marker(row):
+    return {MARKER: row['id']}
+
+
+def record_id(field, offset, chunk):
+    return digest({'field': field, 'offset': offset, 'chunk': chunk})
+
+
+def logical_digest(state):
+    return digest({key: value for key, value in state.items() if key != META})
+
+
+class HistoryArchive:
+    def __init__(self, state_path):
+        self.root = Path(state_path).parent / 'history-archive-v1'
+
+    def _directory(self, kind, create=False):
+        check(kind in ('chunks', 'indexes'), 'Unknown archive object kind')
+        for path in (self.root, self.root / kind):
+            if create:
+                try:
+                    path.mkdir(mode=0o700)
+                    parent = os.open(path.parent, os.O_RDONLY)
+                    try:
+                        os.fsync(parent)
+                    finally:
+                        os.close(parent)
+                except FileExistsError:
+                    pass
+            info = path.lstat()
+            check(stat.S_ISDIR(info.st_mode) and not path.is_symlink(),
+                  'Archive directories must be real directories')
+        return self.root / kind
+
+    def _path(self, kind, ref, create=False):
+        check(isinstance(ref, dict) and set(ref) == {'sha256', 'bytes'},
+              'Invalid archive object descriptor')
+        check(isinstance(ref['sha256'], str) and re.fullmatch('[0-9a-f]{64}', ref['sha256']),
+              'Invalid archive digest')
+        check(type(ref['bytes']) is int and ref['bytes'] > 0, 'Invalid archive byte count')
+        return self._directory(kind, create) / (ref['sha256'] + '.json')
+
+    def get(self, kind, ref):
+        path = self._path(kind, ref)
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+        try:
+            before = os.fstat(fd)
+            check(stat.S_ISREG(before.st_mode) and before.st_nlink == 1,
+                  'Archive object must be a regular single-link file')
+            check(before.st_size == ref['bytes'], 'Archive byte count mismatch')
+            with os.fdopen(fd, 'rb', closefd=False) as stream:
+                raw = stream.read(ref['bytes'] + 1)
+            after = os.fstat(fd)
+            check((before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
+                  (after.st_size, after.st_mtime_ns, after.st_ctime_ns),
+                  'Archive object changed during read')
+            check(descriptor(raw) == ref, 'Archive content digest mismatch')
+            return json.loads(raw)
+        finally:
+            os.close(fd)
+
+    def put(self, kind, value):
+        raw = encoded(value)
+        ref = descriptor(raw)
+        path = self._path(kind, ref, create=True)
+        # Link an already fsynced temp file into its immutable digest name. A
+        # crash can leave an unreferenced object, never a partial referenced one.
+        fd, temp = tempfile.mkstemp(prefix='.pending-', dir=path.parent)
+        try:
+            with os.fdopen(fd, 'wb') as stream:
+                stream.write(raw)
+                stream.flush()
+                os.fsync(stream.fileno())
+                os.fchmod(stream.fileno(), 0o400)
+            try:
+                os.link(temp, path)
+            except FileExistsError:
+                pass
+        finally:
+            os.unlink(temp)
+        self._recover_interrupted_publication(path, ref)
+        directory = os.open(path.parent, os.O_RDONLY)
+        try:
+            os.fsync(directory)
+        finally:
+            os.close(directory)
+        check(self.get(kind, ref) == value, 'Archive readback mismatch')
+        return ref
+
+    def _recover_interrupted_publication(self, path, ref):
+        """Explicit put retry only: retire authenticated same-inode temp links.
+
+        A crash can occur after link(temp, digest) and before unlink(temp). Never
+        overwrite a digest object or delete arbitrary links. Every extra link
+        must be accounted for by this directory's owned publication temp names,
+        and the retained digest bytes must verify before any temp is removed.
+        """
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
+        try:
+            before = os.fstat(fd)
+            if before.st_nlink == 1:
+                return
+            check(stat.S_ISREG(before.st_mode) and before.st_uid == os.getuid()
+                  and before.st_mode & 0o777 == 0o400 and before.st_size == ref['bytes'],
+                  'Cannot recover unowned or mutable publication links')
+            with os.fdopen(fd, 'rb', closefd=False) as stream:
+                raw = stream.read(ref['bytes'] + 1)
+            check(descriptor(raw) == ref, 'Interrupted publication content mismatch')
+            candidates = []
+            for pending in path.parent.iterdir():
+                if not re.fullmatch(r'\.pending-[a-z0-9_]{8}', pending.name):
+                    continue
+                info = pending.lstat()
+                if (info.st_dev, info.st_ino) == (before.st_dev, before.st_ino):
+                    check(stat.S_ISREG(info.st_mode) and info.st_uid == before.st_uid,
+                          'Unowned pending publication link')
+                    candidates.append(pending)
+            check(len(candidates) == before.st_nlink - 1,
+                  'Unaccounted archive hardlink; recovery refused')
+            checked = os.fstat(fd)
+            stable = ('st_dev', 'st_ino', 'st_mode', 'st_uid', 'st_gid', 'st_size',
+                      'st_mtime_ns', 'st_ctime_ns', 'st_nlink')
+            check(all(getattr(checked, name) == getattr(before, name) for name in stable),
+                  'Publication inode changed during recovery validation')
+            for offset, pending in enumerate(candidates):
+                current = os.fstat(fd)
+                linked = pending.lstat()
+                check((current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns,
+                       current.st_nlink) ==
+                      (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns,
+                       before.st_nlink - offset) and
+                      (linked.st_dev, linked.st_ino) == (before.st_dev, before.st_ino),
+                      'Publication links changed during recovery')
+                os.unlink(pending)
+        finally:
+            os.close(fd)
+
+    def index(self, state):
+        meta = state.get(META)
+        if meta is None:
+            return {'format': FORMAT, 'records': [], 'receipts': []}
+        check(isinstance(meta, dict) and set(meta) == {'format', 'index'},
+              'Invalid history archive root')
+        check(meta['format'] == FORMAT, 'Unsupported history archive format')
+        index = self.get('indexes', meta['index'])
+        check(index.get('format') == FORMAT and isinstance(index.get('records'), list)
+              and isinstance(index.get('receipts'), list), 'Invalid archive index')
+        ids, active = set(), set()
+        for row in index['records']:
+            check(row['field'] in FIELDS and type(row['offset']) is int and row['offset'] >= 0,
+                  'Index is outside historical handoff scope')
+            check(row['id'] == record_id(row['field'], row['offset'], row['chunk']),
+                  'Archive record identity mismatch')
+            check(type(row.get('logicalJsonBytes')) is int and row['logicalJsonBytes'] > 0,
+                  'Missing logical history byte count')
+            check(row['id'] not in ids and type(row['active']) is bool, 'Duplicate archive identity')
+            ids.add(row['id'])
+            location = (row['field'], row['offset'])
+            if row['active']:
+                check(location not in active, 'Duplicate active archive location')
+                active.add(location)
+        return index
+
+    def hydrate(self, state, field=None):
+        """Mutate this freshly read physical state, loading only requested field."""
+        index = self.index(state)
+        for row in index['records']:
+            if not row['active'] or (field is not None and row['field'] != field):
+                continue
+            entries = state['handoff'][row['field']]
+            check(isinstance(entries, list) and row['offset'] < len(entries),
+                  'Archive location is missing')
+            check(entries[row['offset']] == marker(row), 'Archive marker mismatch')
+            # Separate get() per occurrence intentionally avoids introducing
+            # Python aliases when equal snapshots share an immutable chunk.
+            entries[row['offset']] = self.get('chunks', row['chunk'])
+        return state
+
+    def compact(self, logical):
+        """Return a shallow copy with only archived history arrays replaced."""
+        if META not in logical:
+            return logical
+        index = self.index(logical)
+        physical = dict(logical)
+        physical['handoff'] = dict(logical['handoff'])
+        changed_index = False
+        copied = set()
+        for row in index['records']:
+            if not row['active']:
+                continue
+            values = logical['handoff'].get(row['field'])
+            current = values[row['offset']] if isinstance(values, list) and row['offset'] < len(values) else None
+            check(current != marker(row), 'Store.write requires reconstructed logical values')
+            original = self.get('chunks', row['chunk'])
+            if digest(current) != row['chunk']['sha256']:
+                # Ordinary Store/subclass edits retain their original semantics.
+                # The edited value is inline; the old immutable version remains
