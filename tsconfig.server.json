{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist/local"
  },
  "include": ["server/**/*.ts", "tooling/launch.ts", "tooling/launcher.ts", "src/protocol/**/*.ts"]
}
